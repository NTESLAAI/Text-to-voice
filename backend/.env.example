# Template only: no working credentials or approved deployment target.
# Configure DEV, TEST and PRODUCTION independently; never reuse application DB
# settings for inspection/acceptance tools. Do not run migrations from this file.
# Empty required values deliberately fail configuration checks.

# Database/PostgreSQL -- REQUIRED for application startup and Prisma commands.
# Supply the explicitly approved database URL through protected local configuration.
DATABASE_URL=

# JWT/Auth/CORS
# REQUIRED: a private, randomly generated JWT signing secret (not a placeholder).
JWT_SECRET=
# OPTIONAL in code (defaults to no allowed browser origins); REQUIRED for Web use.
# Comma-separated exact frontend origins. Replace the reserved example domain.
CORS_ORIGINS=https://web.example.invalid

# AI/OpenRouter -- REQUIRED for application startup; never expose in frontend.
OPENROUTER_API_KEY=

# SMTP/password reset -- REQUIRED together to deliver reset email.
# The trusted frontend URL MUST be HTTPS, without query, fragment or credentials.
PASSWORD_RESET_FRONTEND_URL=https://web.example.invalid/reset-password
SMTP_HOST=
# REQUIRED for mail: 587 (STARTTLS) or 465 (TLS).
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SePay/bank transfer -- REQUIRED before using the respective payment feature.
# HMAC secret, expected gateway and receiving account must match SePay settings.
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_GATEWAY=
BANK_TRANSFER_ACCOUNT_NUMBER=
# Display information used by bank-transfer responses; configure before launch.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=

# Store Billing -- feature-conditional; does NOT enable mobile purchases.
# OPTIONAL: empty mapping has no products; no commercial product IDs are assumed.
# Entries use platform/productId/planCode; GOOGLE additionally needs basePlanId.
STORE_PRODUCT_MAPPING=[]
# REQUIRED when processing store ledger references: base64 of a private 32-byte key.
# Keep the same protected key for decryption; do not rotate without a separate plan.
STORE_REFERENCE_ENCRYPTION_KEY_BASE64=

# Apple -- REQUIRED when verifying Apple purchases/notifications.
# Exact supported environment names: Sandbox or Production.
APPLE_STORE_ENVIRONMENT=Sandbox
APPLE_BUNDLE_ID=
# REQUIRED only for Apple Production verification; numeric App Store app ID.
APPLE_APP_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=
# Base64 DER root certificates, comma-separated if more than one.
APPLE_ROOT_CA_DER_BASE64=

# Google -- REQUIRED when verifying Google purchases.
# Environment selects accepted purchase type; it is not a different API endpoint.
GOOGLE_PLAY_ENVIRONMENT=Sandbox
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# REQUIRED additionally for authenticated RTDN notifications.
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=

# Workload/operations -- OPTIONAL, shown values match current source defaults.
# Single-instance RAM limits; AI input budgets are NOT subscription/plan quotas.
PORT=3000
AI_MAX_CONCURRENT=4
AI_USER_REQUESTS_PER_MINUTE=10
AI_REQUEST_TIMEOUT_MS=120000
AI_DAILY_INPUT_CHARACTERS=1000000
AI_DAILY_PROVIDER_CALLS=1000
AI_REVIEW_MAX_OUTPUT_TOKENS=4096

# No environment switch is provided here for purchaseEnabled or readiness.
# Keep NOT_READY and purchaseEnabled=false until separately approved.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects            Project[]
  subscriptions       Subscription[]
  usages              Usage[]
  payments            Payment[]
  passwordResetTokens PasswordResetToken[]
}

model Plan {
  id             String  @id @default(uuid())
  code           String  @unique
  name           String
  price          Float
  currency       String  @default("VND")
  durationDays   Int
  characterLimit Int
  isActive       Boolean @default(true)

  subscriptions Subscription[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id     String @id @default(uuid())
  userId String
  planId String

  startedAt DateTime
  expiresAt DateTime
  status    String

  characterLimit     Int
  rolloverCharacters Int @default(0)

  pricePaid Float?
  currency  String @default("VND")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan Plan @relation(fields: [planId], references: [id])

  usages Usage[]

  quotaLots QuotaLot[]

  @@index([userId])
  @@index([planId])
  @@index([expiresAt])
}

model Payment {
  id String @id @default(uuid())

  userId String
  planId String

  amount   Float
  currency String @default("VND")

  status   String
  provider String

  providerTransactionId String?
  reference             String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([providerTransactionId])
  @@index([reference])
}

model Usage {
  id             String  @id @default(uuid())
  userId         String
  subscriptionId String?

  characters  Int
  type        String
  referenceId String?

  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([createdAt])
}

model QuotaLot {
  id String @id @default(uuid())

  subscriptionId String

  // Lot trực tiếp tạo ra lot này khi rollover.
  // null = quota gốc của subscription.
  sourceLotId String?

  charactersGranted   Int
  charactersRemaining Int

  // 0 = quota chưa rollover
  // 1 = quota đã rollover, không được rollover tiếp
  rolloverCount Int @default(0)

  // Thời điểm lot này hết hạn
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  sourceLot QuotaLot? @relation("QuotaLotRollover", fields: [sourceLotId], references: [id], onDelete: SetNull)

  rolloverLots QuotaLot[] @relation("QuotaLotRollover")

  @@unique([sourceLotId])
  @@index([subscriptionId])
  @@index([expiresAt])
}

model Project {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  audios    Audio[]
  dialogues Dialogue[]

  @@index([userId])
}

model Audio {
  id        String @id @default(uuid())
  projectId String

  text     String
  language String

  voice     String
  character String
  tone      String
  emotion   String
  style     String
  speed     Float  @default(1.0)

  provider String?
  model    String?
  fileUrl  String?
  format   String  @default("wav")

  characters Int
  duration   Float?
  cost       Float?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Dialogue {
  id         String   @id @default(uuid())
  projectId  String
  language   String
  fileUrl    String?
  format     String   @default("wav")
  characters Int
  duration   Float?
  provider   String?
  model      String?
  createdAt  DateTime @default(now())

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  speakers DialogueSpeaker[]
  turns    DialogueTurn[]

  @@index([projectId])
}

model DialogueSpeaker {
  id         String @id @default(uuid())
  dialogueId String
  role       String
  gender     String
  age        String
  character  String
  region     String

  dialogue Dialogue @relation(fields: [dialogueId], references: [id], onDelete: Cascade)

  @@unique([dialogueId, role])
  @@index([dialogueId])
}

model DialogueTurn {
  id         String @id @default(uuid())
  dialogueId String
  order      Int
  speaker    String
  text       String
  style      String

  dialogue Dialogue @relation(fields: [dialogueId], references: [id], onDelete: Cascade)

  @@unique([dialogueId, order])
  @@index([dialogueId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AiUsage {
  id String @id @default(uuid())

  userId         String
  subscriptionId String?

  // Tính năng AI đã sử dụng
  // Ví dụ: TEXT_REVIEW
  feature String

  provider String @default("openrouter")
  model    String

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  reasoningTokens  Int @default(0)
  totalTokens      Int @default(0)

  // Chi phí thực tế do OpenRouter trả về, USD
  costUsd           Decimal @db.Decimal(18, 8)
  promptCostUsd     Decimal @default(0) @db.Decimal(18, 8)
  completionCostUsd Decimal @default(0) @db.Decimal(18, 8)

  isByok Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([subscriptionId])
  @@index([feature])
  @@index([createdAt])
}

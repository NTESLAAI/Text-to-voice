generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum PaymentSurplusAction {
  REFUND
  QUOTA
  DAYS
  CREDIT
}

enum PaymentSurplusStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  verifiedReceipts PaymentTransaction[] @relation("ReceiptVerifier")
  id        String   @id @default(uuid())
  email     String?  @unique
  phone     String?  @unique
  password  String?
  authVersion Int @default(0)
  storePurchases StorePurchase[]
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects             Project[]
  subscriptions        Subscription[]
  usages               Usage[]
  payments             Payment[]
  passwordResetTokens  PasswordResetToken[]
  promotionRedemptions PromotionRedemption[]
  surplusHandlingsCreated   PaymentSurplusHandling[] @relation("SurplusHandlingCreatedBy")
  surplusHandlingsCompleted PaymentSurplusHandling[] @relation("SurplusHandlingCompletedBy")
  surplusHandlingsCancelled PaymentSurplusHandling[] @relation("SurplusHandlingCancelledBy")
}

model Plan {
  storeCycles StoreCycle[]
  id             String  @id @default(uuid())
  code           String  @unique
  name           String
  price          Float
  currency       String  @default("VND")
  durationDays   Int
  characterLimit Int
  isActive       Boolean @default(true)

  subscriptions   Subscription[]
  payments        Payment[]
  promotionPrices PromotionPlanPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StorePurchase {
  id String @id @default(uuid())
  platform String
  chainKey String
  userId String
  referenceCipher String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  cycles StoreCycle[]
  @@unique([platform, chainKey])
}

model StoreCycle {
  id String @id @default(uuid())
  platform String
  cycleKey String
  purchaseId String
  planId String
  productId String
  environment String
  state String
  expiresAt DateTime
  startedAt DateTime
  subscriptionId String? @unique
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  autoRenew Boolean
  refundReview Boolean @default(false)
  observedAt DateTime
  deliveryStatus String @default("REVIEW_REQUIRED")
  createdAt DateTime @default(now())
  purchase StorePurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@unique([platform, cycleKey])
  @@index([purchaseId])
}

model Subscription {
  billingSource String @default("WEB")
  storeCycle StoreCycle?
  id     String @id @default(uuid())
  userId String
  planId String

  startedAt DateTime
  expiresAt DateTime
  status    String

  characterLimit     Int
  rolloverCharacters Int @default(0)

  pricePaid Float?
  currency  String @default("VND")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan Plan @relation(fields: [planId], references: [id])

  usages Usage[]

  quotaLots QuotaLot[]

  @@index([userId])
  @@index([planId])
  @@index([expiresAt])
}

model Payment {
  receivingBankAccountId String?
  receivingBankAccount ReceivingBankAccount? @relation(fields: [receivingBankAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([receivingBankAccountId])
  id String @id @default(uuid())

  userId String
  planId String

  // Snapshot thông tin gói tại thời điểm tạo giao dịch
  planNameSnapshot                 String?
  planPriceSnapshot                Float?
  planDurationDaysSnapshot         Int?
  planCharacterLimitSnapshot       Int?
  promotionIdSnapshot              String?
  promotionTitleSnapshot           String?
  promotionPriceSnapshot           Float?
  discountAmountSnapshot           Float?
  // Giá sau khuyến mại, trước khấu trừ credit; không tự backfill dữ liệu cũ.
  effectivePlanPriceSnapshot        Decimal? @db.Decimal(20, 6)
  // Snapshot thông tin gói nguồn khi tạo giao dịch Upgrade
  sourcePlanPriceSnapshot          Float?
  sourcePlanCharacterLimitSnapshot Int?
  // Subscription nguồn của giao dịch Upgrade
  sourceSubscriptionId             String?

  amount   Float
  currency String @default("VND")
  status   String
  provider String

  providerTransactionId String?
  reference             String?
  transferCode          String?   @unique
  paidAt                DateTime?

  // Upgrade
  paymentType   String  @default("NEW_PURCHASE")
  upgradeOption String?
  creditAmount  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan                 @relation(fields: [planId], references: [id])
  transactions PaymentTransaction[]
  surplusHandlings PaymentSurplusHandling[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([providerTransactionId])
  @@index([reference])
}

model PaymentSurplusHandling {
  id             String               @id @default(uuid())
  paymentId      String
  action         PaymentSurplusAction
  status         PaymentSurplusStatus @default(PENDING)
  amount         Decimal              @db.Decimal(20, 6)
  currency       String
  idempotencyKey String               @unique

  // Chỉ ghi nhận credit, chưa cho phép sử dụng/khấu trừ; không có hạn dùng.
  creditRemainingAmount Decimal @default(0) @db.Decimal(20, 6)

  effectivePlanPriceSnapshot  Decimal? @db.Decimal(20, 6)
  planCharacterLimitSnapshot Int?
  planDurationDaysSnapshot   Int?
  convertedCharacters        Int?
  convertedSeconds           BigInt?

  note              String?
  externalReference String?
  createdById       String
  completedById     String?
  cancelledById     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  completedAt       DateTime?
  cancelledAt       DateTime?

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy   User    @relation("SurplusHandlingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy User?   @relation("SurplusHandlingCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  cancelledBy User?   @relation("SurplusHandlingCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  // CHECK về tiền/snapshot/trạng thái cần SQL trong migration mới.
  // Currency khớp Payment và chống vượt dư cần kiểm tra trong transaction có khóa Payment.
  @@index([paymentId, status])
  @@index([action, status])
}

model Usage {
  id             String  @id @default(uuid())
  userId         String
  subscriptionId String?

  characters  Int
  type        String
  referenceId String?

  createdAt DateTime @default(now())

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription     Subscription?          @relation(fields: [subscriptionId], references: [id])
  quotaAllocations UsageQuotaAllocation[]

  @@index([userId])
  @@index([subscriptionId])
  @@index([createdAt])
}

model QuotaLot {
  id String @id @default(uuid())

  subscriptionId String

  // Lot trực tiếp tạo ra lot này khi rollover.
  // null = quota gốc của subscription.
  sourceLotId String?

  charactersGranted   Int
  charactersRemaining Int

  // 0 = quota chưa rollover
  // 1 = quota đã rollover, không được rollover tiếp
  rolloverCount Int @default(0)

  // Thời điểm lot này hết hạn
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  sourceLot QuotaLot? @relation("QuotaLotRollover", fields: [sourceLotId], references: [id], onDelete: SetNull)

  rolloverLots     QuotaLot[]             @relation("QuotaLotRollover")
  usageAllocations UsageQuotaAllocation[]

  @@unique([sourceLotId])
  @@index([subscriptionId])
  @@index([expiresAt])
}

model UsageQuotaAllocation {
  id String @id @default(uuid())

  usageId    String
  quotaLotId String

  characters Int

  createdAt DateTime @default(now())

  usage    Usage    @relation(fields: [usageId], references: [id], onDelete: Cascade)
  quotaLot QuotaLot @relation(fields: [quotaLotId], references: [id], onDelete: Cascade)

  @@index([usageId])
  @@index([quotaLotId])
}

model Project {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  audios    Audio[]
  dialogues Dialogue[]

  @@index([userId])
}

model Audio {
  id        String @id @default(uuid())
  projectId String

  text     String
  language String

  voice     String
  character String
  tone      String
  emotion   String
  style     String
  speed     Float  @default(1.0)

  provider String?
  model    String?
  fileUrl  String?
  format   String  @default("wav")

  characters Int
  duration   Float?
  cost       Float?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Dialogue {
  id         String   @id @default(uuid())
  projectId  String
  language   String
  fileUrl    String?
  format     String   @default("wav")
  characters Int
  duration   Float?
  provider   String?
  model      String?
  createdAt  DateTime @default(now())

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  speakers DialogueSpeaker[]
  turns    DialogueTurn[]

  @@index([projectId])
}

model DialogueSpeaker {
  id         String @id @default(uuid())
  dialogueId String
  role       String
  gender     String
  age        String
  character  String
  region     String

  dialogue Dialogue @relation(fields: [dialogueId], references: [id], onDelete: Cascade)

  @@unique([dialogueId, role])
  @@index([dialogueId])
}

model DialogueTurn {
  id         String @id @default(uuid())
  dialogueId String
  order      Int
  speaker    String
  text       String
  style      String

  dialogue Dialogue @relation(fields: [dialogueId], references: [id], onDelete: Cascade)

  @@unique([dialogueId, order])
  @@index([dialogueId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AiUsage {
  id String @id @default(uuid())

  userId         String
  subscriptionId String?

  // Tính năng AI đã sử dụng
  // Ví dụ: TEXT_REVIEW
  feature String

  provider String @default("openrouter")
  model    String

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  reasoningTokens  Int @default(0)
  totalTokens      Int @default(0)

  // Chi phí thực tế do OpenRouter trả về, USD
  costUsd           Decimal @db.Decimal(18, 8)
  promptCostUsd     Decimal @default(0) @db.Decimal(18, 8)
  completionCostUsd Decimal @default(0) @db.Decimal(18, 8)

  isByok Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([subscriptionId])
  @@index([feature])
  @@index([createdAt])
}

model Promotion {
  id       String          @id @default(uuid())
  title    String
  message  String          @db.Text
  startsAt DateTime
  endsAt   DateTime
  status   PromotionStatus @default(DRAFT)

  planPrices  PromotionPlanPrice[]
  redemptions PromotionRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt, endsAt])
}

model PromotionPlanPrice {
  id               String @id @default(uuid())
  promotionId      String
  planId           String
  promotionalPrice Float

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([promotionId, planId])
  @@index([planId])
}

model PromotionRedemption {
  id          String   @id @default(uuid())
  userId      String
  promotionId String
  paymentId   String   @unique
  redeemedAt  DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@unique([userId, promotionId])
  @@index([promotionId])
}

model PaymentTransaction {
  receivingBankAccountId String?
  receivingBankAccount ReceivingBankAccount? @relation(fields: [receivingBankAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bankReference String?
  verificationSource ReceiptVerificationSource?
  sourceVerifiedAt DateTime?
  sourceVerifiedById String?
  verificationReference String?
  sourceVerifiedBy User? @relation("ReceiptVerifier", fields: [sourceVerifiedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([receivingBankAccountId])
  @@index([sourceVerifiedById])
  id String @id @default(uuid())

  // Null khi chưa xác định hoặc chưa liên kết được đơn hàng.
  paymentId String?

  // Nhà cung cấp: BANK_TRANSFER, hoặc mã nhà cung cấp khác.
  provider String

  // Mã giao dịch do ngân hàng hoặc nhà cung cấp cấp.
  providerTransactionId String?

  // Số tiền thực nhận của lần chuyển khoản.
  amount   Float
  currency String @default("VND")

  // UNMATCHED, RECEIVED, MATCHED, REJECTED,
  // REFUND_PENDING, REFUNDED.
  status String @default("UNMATCHED")

  // Nội dung chuyển khoản hoặc ghi chú phục vụ đối soát.
  reference String?
  note      String?

  receivedAt DateTime?
  matchedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  // Provider-specific partial unique indexes are maintained in migration SQL.
  @@index([paymentId])
  @@index([status])
  @@index([receivedAt])
}

enum ReceivingBankPolicy {
  SEPAY_PRIMARY
  MANUAL_ALLOWED
}

enum ReceiptVerificationSource {
  SEPAY_WEBHOOK
  MANUAL_ADMIN
}

model ReceivingBankAccount {
  id String @id @default(uuid())
  code String @unique
  bankCode String
  accountNumber String
  accountName String
  currency String @default("VND")
  policy ReceivingBankPolicy
  isActive Boolean @default(false)
  deactivatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments Payment[]
  receipts PaymentTransaction[]
  @@unique([bankCode, accountNumber])
}

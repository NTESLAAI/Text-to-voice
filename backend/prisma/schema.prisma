generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String?
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  projects      Project[]
  subscriptions Subscription[]
  usages        Usage[]
}

model Plan {
  id             String         @id @default(uuid())
  code           String         @unique
  name           String
  price          Float
  currency       String         @default("VND")
  durationDays   Int
  characterLimit Int
  isActive       Boolean        @default(true)

  subscriptions  Subscription[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  planId    String

  startedAt DateTime
  expiresAt DateTime
  status    String

  pricePaid Float?
  currency  String   @default("VND")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan     @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([expiresAt])
}

model Usage {
  id          String   @id @default(uuid())
  userId      String

  characters  Int
  type        String
  referenceId String?

  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Project {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audios    Audio[]
  dialogues Dialogue[]

  @@index([userId])
}

model Audio {
  id           String   @id @default(uuid())
  projectId    String

  text         String
  language     String

  voice        String
  character String
tone      String
emotion   String
style     String
  speed        Float    @default(1.0)

  provider     String?
  model        String?
  fileUrl      String?
  format       String   @default("wav")

  characters   Int
  duration     Float?
  cost         Float?

  createdAt    DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Dialogue {
  id         String            @id @default(uuid())
  projectId  String
  language   String
  fileUrl    String?
  format     String            @default("wav")
  characters Int
  duration   Float?
  provider   String?
  model      String?
  createdAt  DateTime          @default(now())

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  speakers   DialogueSpeaker[]
  turns      DialogueTurn[]

  @@index([projectId])
}

model DialogueSpeaker {
  id         String   @id @default(uuid())
  dialogueId String
  role       String
  gender     String
  age        String
  character  String
  region     String

  dialogue   Dialogue @relation(fields: [dialogueId], references: [id], onDelete: Cascade)

  @@unique([dialogueId, role])
  @@index([dialogueId])
}

model DialogueTurn {
  id         String   @id @default(uuid())
  dialogueId String
  order      Int
  speaker    String
  text       String
  style      String

  dialogue   Dialogue @relation(fields: [dialogueId], references: [id], onDelete: Cascade)

  @@unique([dialogueId, order])
  @@index([dialogueId])
}

# Public build-time configuration only. Never put credentials or API keys here.
# REQUIRED: backend base URL. Reserved example domain; replace per environment.
# Production builds and native apps REQUIRE HTTPS; no credentials/query/fragment.
# Web development may explicitly use its approved local HTTP backend instead.
# Changing this variable requires rebuilding the Web/native assets.
VITE_API_BASE_URL=https://api.example.invalid

# No other application VITE_* variables are currently read by the source.
# This template does not enable mobile purchases; keep purchaseEnabled=false.
